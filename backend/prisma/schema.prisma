datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum JobStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String    @unique
  password      String
  role          Role      @default(USER)
  isVerified    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Organization {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  shortName       String
  category        String
  officialWebsite String?
  jobs            Job[]
  exams           Exam[]
}

model Job {
  id                      String        @id @default(auto()) @map("_id") @db.ObjectId
  title                   String
  slug                    String        @unique
  organizationId          String        @db.ObjectId
  organization            Organization  @relation(fields: [organizationId], references: [id])
  postName                String
  totalVacancies          Int
  qualification           String
  ageLimitMin             Int
  ageLimitMax             Int
  salaryText              String?
  startDate               String
  lastDate                String
  examDate                String?
  officialNotificationUrl String?
  applyOnlineUrl          String?
  selectionProcess        String?
  status                  JobStatus     @default(PUBLISHED)
  isFeatured              Boolean       @default(false)
  isTrending              Boolean       @default(false)
  state                   String?
  category                String?
  viewsCount              Int           @default(0)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
}

model Exam {
  id                  String        @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  slug                String        @unique
  code                String
  organizationId      String        @db.ObjectId
  organization        Organization  @relation(fields: [organizationId], references: [id])
  frequency           String?
  eligibilitySummary  String?
  selectionProcess    String?
  examPatternSummary  String?
  isPopular           Boolean       @default(false)
  viewsCount          Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model MockTest {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  slug            String        @unique
  examName        String
  examCategory    String        @default("GOVT")
  durationMinutes Int           @default(60)
  totalQuestions  Int           @default(100)
  totalMarks      Int           @default(200)
  difficulty      String        @default("MODERATE")
  attemptsCount   Int           @default(0)
  isLive          Boolean       @default(true)
  questions       Question[]
  results         TestResult[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

type QuestionOption {
  id        String
  text      String
  textHindi String?
  isCorrect Boolean @default(false)
}

model Question {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  testId        String           @db.ObjectId
  test          MockTest         @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionText  String
  questionHindi String?
  options       QuestionOption[]
  explanation   String?
  subject       String
  difficulty    String           @default("MEDIUM")
  marks         Float            @default(2)
  negativeMarks Float            @default(0.5)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model TestResult {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  testId            String    @db.ObjectId
  test              MockTest  @relation(fields: [testId], references: [id], onDelete: Cascade)
  userId            String?   @db.ObjectId
  candidateName     String    @default("Anonymous Aspirant")
  score             Float
  totalMarks        Float
  accuracyPercent   Float
  timeTakenSeconds  Int
  correctCount      Int
  incorrectCount    Int
  unattemptedCount  Int
  createdAt         DateTime  @default(now())
}

model TechJob {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String    @unique
  company     String
  location    String
  jobType     String    @default("FULL_TIME")
  experience  String
  salaryText  String?
  skills      String[]
  applyUrl    String?
  isTrending  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

type LessonQuizQuestion {
  id          String
  question    String
  options     String[]
  answer      Int
  explanation String?
}

type CourseLesson {
  id          String
  title       String
  duration    String
  videoUrl    String?
  summary     String?
  content     String?
  codeSnippet String?
  quiz        LessonQuizQuestion[]
}

type CourseModule {
  id          String
  title       String
  description String?
  lessons     CourseLesson[]
}

model Course {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  slug           String         @unique
  description    String
  category       String
  level          String         @default("Beginner")
  durationHours  Float
  thumbnail      String?
  instructor     String
  instructorRole String?
  badge          String?
  rating         Float          @default(4.9)
  reviewCount    Int            @default(120)
  enrolledCount  Int            @default(0)
  lessonsCount   Int            @default(0)
  skills         String[]
  isPublished    Boolean        @default(true)
  isFree         Boolean        @default(true)
  modules        CourseModule[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model CourseEnrollment {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  userId             String
  userName           String    @default("Learner")
  userEmail          String?
  courseId           String    @db.ObjectId
  courseSlug         String
  completedLessonIds String[]
  progressPercent    Float     @default(0)
  isCompleted        Boolean   @default(false)
  completedAt        DateTime?
  certificateCode    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([userId, courseId])
}

model Certificate {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  certificateCode String   @unique
  courseId        String   @db.ObjectId
  courseTitle     String
  recipientName   String
  recipientEmail  String?
  userId          String?
  issueDate       DateTime @default(now())
  grade           String   @default("Distinction")
  skills          String[]
  createdAt       DateTime @default(now())
}

